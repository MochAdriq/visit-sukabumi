<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect /jelajahsukabumi ke /jelajahsukabumi/ (agar canonical dengan slash)
    RewriteRule ^jelajahsukabumi$ /jelajahsukabumi/ [R=301,L]

    # Tangani jelajahsukabumi agar URL bersih tanpa /public/
    RewriteRule ^jelajahsukabumi/$ public/jelajahsukabumi/index.html [L]
    RewriteRule ^jelajahsukabumi/(.+)$ public/jelajahsukabumi/$1 [L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
